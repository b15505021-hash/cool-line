# NTU COOL Session Cookie（從瀏覽器開發者工具取得的 _normandy_session 值）
COOL_SESSION_COOKIE=

# 台大計中帳號與密碼（選用：供 Playwright 自動重登更新 Cookie 使用）
NTU_STUDENT_ID=
NTU_PASSWORD=

# LINE Messaging API 設定（至 LINE Developers Console 取得）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_USER_ID=

# Google Gemini API 金鑰（至 Google AI Studio 取得）
GEMINI_API_KEY=

# Gmail IMAP 讀信設定（選用：兩者皆有填寫才會啟用副軌讀信）
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# GAS 網頁應用程式網址（選用：供 GitHub Actions / cloud_sync.py 將未繳交清單同步至 LINE 卡片）
GAS_WEBHOOK_URL=
